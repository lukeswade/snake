# Cloudflare Pages header rules

# The service worker must always be revalidated, otherwise a cached copy can
# pin visitors to an old asset manifest.
/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

# Font filenames are content-hashed by Google Fonts, so they never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
